{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "board",
  "main": "src/worker.ts",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // One Durable Object per board: its log, tables, and schedule in the object's SQLite.
  "durable_objects": { "bindings": [{ "name": "BOARD", "class_name": "Board" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Board"] }],
  // Attachments. Create it once: `wrangler r2 bucket create board-files`.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "board-files" }],
  "vars": {
    // Your Zero Trust team and the Access application's AUD tag, to let people in through Cloudflare Access.
    "ACCESS_TEAM": "",
    "ACCESS_AUD": ""
  }
  // Secrets: `wrangler secret put BOARD_TOKENS` with `{"ada":"<a long random token>"}`, for the CLI and agents.
}
